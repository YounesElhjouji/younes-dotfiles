#!/usr/bin/env bash
set -euo pipefail

IDLE_MINUTES="${IDLE_MINUTES:-30}"

# Count non-root users with an active login session (pts/*)
active_sessions="$(who | awk '$2 ~ /^pts\// {print $1}' | wc -l | tr -d ' ')"

if [[ "$active_sessions" -eq 0 ]]; then
  # Track how long we've been idle using a timestamp file
  stamp="/var/run/idle-ssh-since"
  now="$(date +%s)"

  if [[ ! -f "$stamp" ]]; then
    echo "$now" | sudo tee "$stamp" >/dev/null
    exit 0
  fi

  since="$(cat "$stamp")"
  idle_seconds="$(( now - since ))"
  if (( idle_seconds >= IDLE_MINUTES * 60 )); then
    sudo shutdown -h now
  fi
else
  sudo rm -f /var/run/idle-ssh-since
fi
